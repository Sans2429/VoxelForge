<Window x:Class="OctTreeVoxel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ddes="http://schemas.devdept.com/winfx/2008/xaml/control"
        xmlns:eyeshot="clr-namespace:devDept.Eyeshot;assembly=devDept.Eyeshot.v2023"
        xmlns:local="clr-namespace:OctTreeVoxel"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width"
                    Value="40" />
            <Setter Property="Margin"
                    Value="0,2,10,2" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ddes:Design Name="design1">
            <ddes:Design.Viewports>
                <ddes:Viewport>
                    <ddes:Viewport.Background>
                        <ddes:BackgroundSettings />
                    </ddes:Viewport.Background>
                    <ddes:Viewport.CoordinateSystemIcon>
                        <ddes:CoordinateSystemIcon Lighting="False" />
                    </ddes:Viewport.CoordinateSystemIcon>
                    <ddes:Viewport.ToolBars>
                        <ddes:ToolBar Position="VerticalMiddleRight">
                            <ddes:ToolBar.Buttons>
                                <ddes:HomeToolBarButton />
                                <ddes:MagnifyingGlassToolBarButton />
                                <ddes:ZoomWindowToolBarButton />
                                <ddes:ZoomToolBarButton />
                                <ddes:PanToolBarButton />
                                <ddes:RotateToolBarButton />
                                <ddes:ZoomFitToolBarButton />
                            </ddes:ToolBar.Buttons>
                        </ddes:ToolBar>
                    </ddes:Viewport.ToolBars>
                    <ddes:Viewport.ViewCubeIcon>
                        <ddes:ViewCubeIcon Lighting="False" />
                    </ddes:Viewport.ViewCubeIcon>
                </ddes:Viewport>
            </ddes:Design.Viewports>
        </ddes:Design>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal">
            <Button Content="Cut"
                    Click="Cut_Click" />
            <GroupBox Header="Axis">
                <StackPanel Orientation="Horizontal">
                    <Button Content="X"
                            Click="Button_Click" />
                    <Button Content="Y"
                            Click="Button_Click" />
                    <Button Content="Z"
                            Click="Button_Click" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="MoveDirection">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Plus"
                            Click="Move_Click" />
                    <Button Content="Minus"
                            Click="Move_Click" />
                    <Button Content="CutPlus"
                            Click="Move_Cut_Click" />
                    <Button Content="CutMinus"
                            Click="Move_Cut_Click" />
                </StackPanel>

            </GroupBox>

            <GroupBox Header="MoveStep">
                <ComboBox SelectionChanged="ComboBox_SelectionChanged"
                          ItemsSource="{Binding StepsToMove,Mode=TwoWay}"
                          SelectedItem="{Binding StepToMove}"
                          SelectedIndex="0"/>
            </GroupBox>

        </StackPanel>
    </Grid>
</Window>
